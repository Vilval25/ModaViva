rules_version = '2';

// Reglas de Cloud Storage (HT-02 CA-04).
//
// Las fotos del catálogo y de las categorías son públicas y solo las sube el
// back-office (script de carga o consola). Todo lo demás se rechaza; las fotos
// de los clientes para el probador (HU-11) tendrán sus propias reglas.
service firebase.storage {
  match /b/{bucket}/o {

    match /prendas/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /categorias/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Fotos de la vitrina de Inicio (portada de campaña, HU-04).
    match /inicio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Fotos privadas del cliente para el probador virtual (HU-11 CA-06) y resultados generados.
    // Solo el cliente autenticado puede leer, escribir o eliminar sus propios archivos.
    match /clientes/{userId}/probador/{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Fotos de las solicitudes de cambio o devolución (HU-24 CA-04): solo
    // imágenes de hasta 5 MB, máximo 3 por solicitud (foto_1 a foto_3), y no
    // se reemplazan ni se borran desde la app una vez enviadas.
    match /clientes/{userId}/solicitudes/{solicitudId}/{foto} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && resource == null
        && foto.matches('foto_[1-3][.]jpg')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
