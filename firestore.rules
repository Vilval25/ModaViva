rules_version = '2';

// Reglas de Firestore (HT-02 CA-04). El modelo está en docs/modelo-datos.md.
//
// - Cada cliente solo puede leer y escribir sus propios datos.
// - El catálogo es de solo lectura para la app, también para invitados.
// - Lo que solo usa el servidor (cupones) no se puede leer desde la app.
// - Todo lo que no está listado aquí se rechaza.
//
// Las Cloud Functions y el script de carga usan el Admin SDK, que no pasa por
// estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- Datos de cada cliente -------------------------------------------

    match /clientes/{uid} {
      allow read, create, update: if isOwner(uid);
      // El perfil no se borra desde la app.
      allow delete: if false;

      match /favoritos/{prendaId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['agregadoEn'])
          && request.resource.data.agregadoEn is timestamp;
      }

      match /carrito/{varianteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys()
               .hasOnly(['prendaId', 'talla', 'cantidad', 'agregadoEn'])
          && request.resource.data.prendaId is string
          && request.resource.data.talla is string
          && request.resource.data.cantidad is int
          && request.resource.data.cantidad >= 1
          && request.resource.data.cantidad <= 99;
      }

      match /pedidos/{pedidoId} {
        allow read, write: if isOwner(uid);
      }

      // Tarjetas guardadas (HU-21 CA-03, CA-04). Las registra la pasarela del
      // servidor (Cloud Functions). La app solo puede leerlas, eliminarlas y
      // cambiar cuál es la predeterminada; los datos de demostración solo
      // pueden traer marca, últimos 4, vencimiento y token (nunca PAN ni CVV).
      match /metodosPago/{tarjetaId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['esPredeterminada'])
          && request.resource.data.esPredeterminada is bool;
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['marca', 'ultimos4', 'vencimiento', 'titular',
               'tipo', 'tokenPasarela', 'esPredeterminada', 'creadoEn'])
          && request.resource.data.ultimos4 is string
          && request.resource.data.ultimos4.matches('^[0-9]{4}$')
          && request.resource.data.tokenPasarela is string
          && request.resource.data.tokenPasarela.matches('^tok_.*');
      }

      // Solicitudes de cambio o devolución (HU-24). El cliente solo las crea
      // 'En evaluación' para un pedido suyo entregado y las lee; el estado y la
      // resolución los cambia el back-office (CA-07), nunca la app.
      match /solicitudes/{solicitudId} {
        allow read: if isOwner(uid);
        allow update, delete: if false;
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['numeroSolicitud', 'pedidoId', 'numeroPedido',
               'prendaCodigo', 'prendaNombre', 'prendaFotoUrl', 'talla', 'tipo', 'motivo',
               'detalleOtro', 'fotosUrls', 'tuvoPruebaVirtual', 'estado', 'creadaEnMillis', 'creadaEn'])
          && request.resource.data.estado == 'EN_EVALUACION'
          && request.resource.data.tipo in ['CAMBIO', 'DEVOLUCION']
          && request.resource.data.motivo is string
          && request.resource.data.motivo.size() > 0
          && (request.resource.data.motivo != 'Otro'
              || (request.resource.data.detalleOtro is string
                  && request.resource.data.detalleOtro.size() >= 5))
          && request.resource.data.fotosUrls is list
          && request.resource.data.fotosUrls.size() <= 3
          && request.resource.data.tuvoPruebaVirtual is bool
          && request.resource.data.creadaEn == request.time
          && get(/databases/$(database)/documents/clientes/$(uid)/pedidos/$(request.resource.data.pedidoId))
               .data.estado == 'ENTREGADO';
      }

      // Centro de notificaciones (HU-18). El cliente lee y borra sus avisos,
      // solo puede cambiar el campo `leida` y crear avisos para sí mismo con
      // la forma esperada. Las Cloud Functions también los crean (Admin SDK).
      match /notificaciones/{avisoId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys()
               .hasOnly(['tipo', 'titulo', 'texto', 'creadaEn', 'leida', 'refId'])
          && request.resource.data.tipo in
               ['PRUEBA_VIRTUAL', 'ELIMINACION_FOTO', 'PEDIDO', 'SOLICITUD', 'GENERAL']
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() <= 120
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 500
          && request.resource.data.creadaEn == request.time
          && request.resource.data.leida == false
          && (!('refId' in request.resource.data) || request.resource.data.refId is string);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
          && request.resource.data.leida is bool;
      }

      // Pruebas virtuales usadas por día (HU-12 CA-07). Solo la Cloud Function
      // probarPrenda las cuenta; la app las lee para mostrar cuántas quedan.
      match /probadorUso/{dia} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Caché de imágenes generadas por el probador virtual (escritura solo desde Cloud Functions)
      match /probadorCache/{prendaId} {
        allow read, delete: if isOwner(uid);
        allow write: if false;
      }
    }

    // --- Catálogo: lectura pública, escritura solo desde el back-office ---

    match /categorias/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /prendas/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /stock/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /tiendas/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /tarifasEnvio/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Contenido de la vitrina de Inicio (portada de campaña), editable solo
    // desde el back-office (HU-04).
    match /inicio/{id} {
      allow read: if true;
      allow write: if false;
    }

    // --- Solo servidor ----------------------------------------------------

    // Los lee la Cloud Function que calcula el pedido (HU-19). Si la app
    // pudiera leerlos, cualquiera podría listar los cupones vigentes.
    match /cupones/{codigo} {
      allow read, write: if false;
    }

    // --- TEMPORAL: eliminar cuando HU-01 se rehaga sin DNI ----------------
    //
    // El registro actual (backlog anterior) reserva el DNI en esta colección
    // para garantizar que sea único. Se permite solo lo que ese código hace:
    // consultar si un DNI existe y reservarlo para la propia cuenta.
    match /documentos/{documento} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authUid'])
        && request.resource.data.authUid == request.auth.uid;
      allow list, update, delete: if false;
    }
  }
}
